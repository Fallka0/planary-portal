# planary-portal: copy to .env.local for development. No secrets live here; the portal only holds
# the signed-in person's Planary token in the browser.

# planary-org (organisations, billing, team, support)
NEXT_PUBLIC_ORG_API=https://org.planary.ch
# Planary Account (sign-in, single sign-on). AUTH_API_URL is the server-side hop for /api/me.
NEXT_PUBLIC_AUTH_BASE_URL=https://auth.planary.ch
AUTH_API_URL=https://auth.planary.ch
# Where "Turnier erstellen", "In Tournament öffnen" and "Beamer-Ansicht" point
NEXT_PUBLIC_TOURNAMENT_URL=https://tournament.planary.ch
NEXT_PUBLIC_PORTAL_URL=https://portal.planary.ch

# Development and screenshot checks only, never in production: answer every call from the
# handoff's sample data, no sign-in, fixed clock 20.10.2026 20:11.
# NEXT_PUBLIC_PORTAL_DATA=fixtures
